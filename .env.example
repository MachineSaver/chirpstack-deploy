# =============================================================================
# ChirpStack Deployment Configuration
# Copy this file to .env and fill in your values, OR run ./setup.sh
# =============================================================================

# --- Deployment Mode ---------------------------------------------------------
# vps   = internet-facing VPS with a domain name (enables HTTPS)
# local = home/office network, no domain required (plain HTTP)
DEPLOY_MODE=local

# Domain name (required if DEPLOY_MODE=vps, leave blank for local)
DOMAIN=

# Email for Let's Encrypt SSL certificate notifications (required if DEPLOY_MODE=vps)
SSL_EMAIL=

# Set to true automatically when DEPLOY_MODE=vps and domain is configured
SSL_ENABLED=false

# --- LoRa Region -------------------------------------------------------------
# US915 = Americas (915 MHz)
# EU868 = Europe (868 MHz)
LORA_REGION=US915

# --- PostgreSQL Database -----------------------------------------------------
POSTGRES_USER=chirpstack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chirpstack

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=changeme

# --- Internal MQTT Broker (Mosquitto) ----------------------------------------
MOSQUITTO_USER=chirpstack
MOSQUITTO_PASSWORD=changeme

# --- ChirpStack Server -------------------------------------------------------
# Secret used for JWT signing — must be a long random string
CHIRPSTACK_SECRET=changeme

# Initial admin account created on first run
CHIRPSTACK_ADMIN_EMAIL=admin@example.com
CHIRPSTACK_ADMIN_PASSWORD=changeme

# --- External MQTT Integration (optional) ------------------------------------
# Set this to forward device data to an external MQTT broker
# Leave blank to disable external MQTT forwarding
# Example: mqtt://user:pass@broker.example.com:1883
EXTERNAL_MQTT_SERVER=
EXPOSE_MQTT=false

# --- Monitoring Stack (Grafana + InfluxDB) -----------------------------------
ENABLE_MONITORING=false
GRAFANA_ROOT_URL=http://localhost/grafana/

INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=changeme
INFLUXDB_ORG=chirpstack
INFLUXDB_BUCKET=chirpstack
INFLUXDB_TOKEN=changeme

# --- Network Ports (change if defaults conflict) -----------------------------
HTTP_PORT=80
HTTPS_PORT=443
MQTT_PORT=1883
GATEWAY_UDP_PORT=1700
GATEWAY_BS_PORT=3001
