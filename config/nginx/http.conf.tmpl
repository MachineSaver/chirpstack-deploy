# Nginx — HTTP-only mode (local network / no domain)
# Generated by scripts/generate-config.sh

upstream chirpstack_ui {
    server chirpstack:8080;
}

upstream chirpstack_api {
    server chirpstack:8090;
}

upstream grafana {
    server grafana:3000;
}

# Basics Station WebSocket gateway bridge (separate TCP port)
upstream gateway_bs {
    server gateway-bridge-bs:3001;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 10M;

    # ChirpStack Web UI
    location / {
        proxy_pass http://chirpstack_ui;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (used by ChirpStack live event views)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }

    # ChirpStack REST API
    location /api/ {
        proxy_pass http://chirpstack_api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Grafana (only active when monitoring profile is enabled)
    location /grafana/ {
        proxy_pass http://grafana/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Basics Station WebSocket listener on port ${GATEWAY_BS_PORT}
server {
    listen ${GATEWAY_BS_PORT};
    server_name _;

    location / {
        proxy_pass http://gateway_bs;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }
}
