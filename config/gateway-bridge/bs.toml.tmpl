# ChirpStack Gateway Bridge — Basics Station (LNS WebSocket) mode
# This file is generated by scripts/generate-config.sh — do not edit directly.
# Listens on TCP port 3001

[backend]
  type="basic_station"

  [backend.basic_station]
    bind="0.0.0.0:3001"
    tls_cert=""
    tls_key=""
    ca_cert=""
    # Required when TLS is terminated by nginx upstream — makes router-info respond with wss://
    tls_support_proxy=true
    ping_interval="1m0s"
    read_timeout="1m5s"
    stats_interval="30s"
    # Region name and frequency bounds used when building the ROUTER_CONFIG sent to the gateway
    region="${BS_REGION}"
    frequency_min=${BS_FREQ_MIN}
    frequency_max=${BS_FREQ_MAX}

${BS_CONCENTRATOR_BLOCK}

[integration]
  marshaler="protobuf"

  [integration.mqtt]
    event_topic_template="${LORA_REGION_ID}/gateway/{{ .GatewayID }}/event/{{ .EventType }}"
    state_topic_template="${LORA_REGION_ID}/gateway/{{ .GatewayID }}/state/{{ .StateType }}"
    command_topic_template="${LORA_REGION_ID}/gateway/{{ .GatewayID }}/command/#"

    [integration.mqtt.auth]
      type="generic"

      [integration.mqtt.auth.generic]
        server="tcp://mosquitto:1883"
        username=""
        password=""

[meta_data]
  [meta_data.static]
