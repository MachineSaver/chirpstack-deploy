# ChirpStack v4 Configuration
# This file is generated by scripts/generate-config.sh — do not edit directly.
# Edit chirpstack.toml.tmpl and re-run the script.

[logging]
  level="info"

[postgresql]
  dsn="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/${POSTGRES_DB}?sslmode=disable"
  max_open_connections=10
  min_idle_connections=0

[redis]
  servers=["redis://:${REDIS_PASSWORD}@redis/"]
  tls_enabled=false
  cluster=false

[network]
  net_id="000000"
  enabled_regions=[
    "${LORA_REGION_ID}",
  ]

[api]
  bind="0.0.0.0:8080"
  secret="${CHIRPSTACK_SECRET}"

[gateway]
  # Gateway backend MQTT is configured per-region in region.toml (generated by generate-config.sh).
  # The [gateway.backend.mqtt] block here is ignored by ChirpStack v4.
  client_cert_lifetime="11months 30days 3h 50m 24s"

[integration]
  enabled=["mqtt"]

  [integration.mqtt]
    server="tcp://${MOSQUITTO_USER}:${MOSQUITTO_PASSWORD}@mosquitto:1883"
    qos=0
    clean_session=false
    client_id=""
    ca_cert=""
    tls_cert=""
    tls_key=""
    json=true

# External MQTT forwarding (only written when EXTERNAL_MQTT_SERVER is set)
${EXTERNAL_MQTT_BLOCK}

# InfluxDB integration (only written when ENABLE_MONITORING=true)
${INFLUXDB_BLOCK}

[codec]
  js_timeout="500ms"

[user_authentication]
  # Users are managed in the ChirpStack database via the web UI
  enabled="internal"

  [user_authentication.openid_connect]
    enabled=false

[join_server]
  # Use internal join server (handles OTAA locally)
  enabled=true
  bind="0.0.0.0:8003"
  ca_cert=""
  tls_cert=""
  tls_key=""
  backend_interfaces_bind="0.0.0.0:8004"
  backend_interfaces_ca_cert=""
  backend_interfaces_tls_cert=""
  backend_interfaces_tls_key=""

[monitoring]
  bind="0.0.0.0:8070"
  meta_log_max_history=10
  gateway_frame_log_max_history=10
  device_frame_log_max_history=10
  device_event_log_max_history=10
  per_gateway_frame_log_max_history=10
  per_gateway_frame_log_ttl="1month 13h 26m 24s"
  per_device_frame_log_max_history=10
  per_device_frame_log_ttl="1month 13h 26m 24s"
  per_device_event_log_max_history=10
  per_device_event_log_ttl="1month 13h 26m 24s"
